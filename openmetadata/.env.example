# Copy this file to openmetadata/.env before the first deployment.
# Use long, independently generated secrets; never commit the real .env file.

OM_DB_USER=openmetadata_user
OM_DB_PASSWORD=replace-with-a-strong-random-password
OM_DATABASE=openmetadata_db

OM_AIRFLOW_DB_USER=airflow_user
OM_AIRFLOW_DB_PASSWORD=replace-with-a-different-strong-random-password
OM_AIRFLOW_DATABASE=airflow_db

OM_AIRFLOW_ADMIN_USERNAME=admin
OM_AIRFLOW_ADMIN_PASSWORD=replace-with-a-strong-random-password
OM_AIRFLOW_FERNET_KEY=replace-with-a-generated-fernet-key
OM_AIRFLOW_PASSWORDS_FILE=/opt/airflow/dag_generated_configs/simple_auth_manager_passwords.json

# Keep this value stable after OpenMetadata has encrypted stored credentials.
OM_SERVER_FERNET_KEY=replace-with-a-generated-fernet-key
