# ============================================
# DataMind Backend Configuration
# ============================================

# --- Application ---
APP_NAME=DataMind
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# --- PostgreSQL (platform metadata DB) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=datamind
DB_PASSWORD=datamind
DB_NAME=datamind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis (cache + token blacklist) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT Auth ---
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Encryption (for component credentials) ---
ENCRYPTION_KEY=your-fernet-key

# --- Airflow Polling ---
AIRFLOW_POLL_INTERVAL_SECONDS=10
