# DataMind unified deployment configuration
# Copy to .env and replace every "change-me" value before deployment.

# DataMind application
APP_NAME=DataMind
APP_VERSION=1.1.1
DATAMIND_VERSION=1.1.1
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
BOOTSTRAP_ADMIN=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin-password-at-least-12-characters

# Internal service security
EXECUTOR_TOKEN=change-me-random-executor-token-at-least-24-characters
JWT_SECRET_KEY=change-me-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-generated-fernet-key
CUBE_API_SECRET=change-me-random-cube-api-secret
LINEAGE_EVENT_TOKEN=change-me-random-lineage-event-token-at-least-24-characters

# Shared PostgreSQL instance: DataMind database
DB_HOST=postgres
DB_PORT=5432
DB_USER=datamind
DB_PASSWORD=change-me-datamind-database-password
DB_NAME=datamind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Airflow 3.3.1 shares this PostgreSQL server but uses its own airflow database/user.
# The development deployment reuses DB_PASSWORD for the isolated airflow role.
AIRFLOW_UID=50000

# Host port bindings. Keep PostgreSQL local; management services may be
# restricted to 127.0.0.1 when accessed through a reverse proxy or VPN.
DATAMIND_BIND_ADDRESS=0.0.0.0
MANAGEMENT_BIND_ADDRESS=0.0.0.0
POSTGRES_BIND_ADDRESS=127.0.0.1
DATAMIND_HTTP_PORT=80
BACKEND_PORT=8000
MCP_PORT=8001
CUBE_PORT=4000
AIRFLOW_PORT=8082

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# Cube connection to Doris
CUBEJS_DEV_MODE=false
CUBEJS_DB_TYPE=mysql
CUBEJS_DB_HOST=change-me-doris-host
CUBEJS_DB_PORT=9030
CUBEJS_DB_NAME=ads
CUBEJS_DB_USER=change-me-doris-user
# Doris installations that intentionally use a passwordless account may leave this empty.
CUBEJS_DB_PASS=change-me-doris-password

# Runtime tuning
AIRFLOW_POLL_INTERVAL_SECONDS=10
SPARK_MASTER=local[2]
